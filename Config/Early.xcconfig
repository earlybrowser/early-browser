// SPDX-License-Identifier: MPL-2.0

// The project's GitHub namespace (2026-10-24). The sandbox container, website
// data, Keychain items and settings are keyed by it, so never change it.
PRODUCT_BUNDLE_IDENTIFIER = io.github.earlybrowser.Early
// Apple Silicon only; there's no Intel Mac to test on.
ARCHS = arm64
// Sparkle is embedded in Contents/Frameworks.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
PRODUCT_NAME = Early
ASSETCATALOG_COMPILER_APPICON_NAME = Early
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO
ENABLE_APP_SANDBOX = YES
CODE_SIGN_ENTITLEMENTS = Config/Early.entitlements
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Early
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
MARKETING_VERSION = 0.1.4
CURRENT_PROJECT_VERSION = 1
